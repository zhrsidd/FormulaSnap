{
  "productName": "FormulaSnap",
  "version": "1.1.0",
  "identifier": "com.formulasnap.com",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "FormulaSnap",
        "width": 650,
        "height": 520,
        "resizable": false,
        "center": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDNzNENEUxMUE4OTgzOTEKUldTUmc0a2E0ZFJ6TENzVWQyWDVHcG9aTk1OOTBEUGVWaTdFUHdVV3I2REhIQWc4OWlOMWJyUmMK",
      "endpoints": [
        "https://github.com/zhrsidd/FormulaSnap/releases/latest/download/latest.json"
      ]
    }
  }
}
