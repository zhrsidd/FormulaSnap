# -------------------------
# FormulaSnap .gitignore
# -------------------------

# Node dependencies
node_modules/

# Frontend build output
dist/

# Rust / Tauri build output
target/
src-tauri/target/

# Tauri generated files
src-tauri/gen/
gen/schemas/

# Environment files
.env
.env.local
.env.*.local

# macOS
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Rust backup files
**/*.rs.bk

# VS Code local settings
.vscode/